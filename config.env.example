# ==============================================================================
# ESP32-S3 Audio Streamer & Whisper 统一配置模板
# 使用说明:
#   1. 复制本文件为 config.env:  cp config.env.example config.env
#   2. 填入您的 WiFi 名称、密码和电脑局域网 IP
#   3. 重新编译固件与运行后端即可直接生效，无需手动打开 menuconfig！
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 路由器 WiFi 配置 (固件端连接使用)
# ------------------------------------------------------------------------------
WIFI_SSID=YOUR_WIFI_SSID
WIFI_PASSWORD=YOUR_WIFI_PASSWORD

# ------------------------------------------------------------------------------
# 2. 推流目标服务端配置 (ESP32 推流目标 与 Python 后端服务端口)
# ------------------------------------------------------------------------------
# 运行 Python 服务的电脑在局域网中的 IP (ESP32 会直接向此地址建立 WebSocket 推流)
# macOS 可在终端运行: ifconfig | grep "inet " | grep -v 127.0.0.1
# Windows 可在终端运行: ipconfig
SERVER_HOST=192.168.1.100
SERVER_PORT=8000

# ------------------------------------------------------------------------------
# 3. 硬件引脚映射 (INMP441 I2S 数字麦克风)
# ------------------------------------------------------------------------------
I2S_MIC_WS_GPIO=4
I2S_MIC_SCK_GPIO=5
I2S_MIC_SD_GPIO=6
AUDIO_GAIN_BOOST=2

# ------------------------------------------------------------------------------
# 4. 后端语音识别与同传翻译配置
# ------------------------------------------------------------------------------
# 语音识别默认语言: auto (自动多语种), zh (中文), en (英文), ja (日文), ko (韩文), yue (粤语)
DEFAULT_LANGUAGE=auto
# 实时同传翻译目标语言: zh (翻译为中文), en (翻译为英文), none (不翻译)
TRANSLATE_TARGET=zh
# VAD 静音切分判定阈值 (0.1 ~ 0.9)
VAD_THRESHOLD=0.5
# 说话停顿断句超时时间 (秒)
SILENCE_THRESHOLD_SECONDS=0.6
